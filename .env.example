# Postgres connection string.
# Local docker:   postgres://moonshade:moonshade@localhost:5433/moonshade
# Supabase/Neon:  copy the pooled connection string from the dashboard
DATABASE_URL="postgres://moonshade:moonshade@localhost:5433/moonshade"

# Run `npx auth secret` to generate one.
AUTH_SECRET=""

# Public URL of this app (needed for Auth.js redirects).
# Local:  http://localhost:3000
# Deploy: https://your-domain.example
AUTH_URL="http://localhost:3000"

# Discord application credentials (https://discord.com/developers/applications).
# Redirect URI must be <your-site>/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# MoonShade Discord server ID (Developer Mode → right-click server → Copy Server ID).
# When set, sign-in requests guilds.members.read and stores the server nickname.
# Required for syncing the member list from Discord.
DISCORD_GUILD_ID=""

# Optional. Comma-separated Discord role IDs — only members with at least one
# of these roles are synced (e.g. your guild's main member / class role).
# Right-click the role in Discord (Developer Mode) → Copy Role ID.
DISCORD_MEMBER_ROLE_IDS=""

# Discord Incoming Webhook URL for the channel that should receive queue posts.
# Keep this secret. Create one in Discord: Channel Settings → Integrations → Webhooks.
# Used to discover the channel ID; the bot posts the actual messages with buttons.
DISCORD_WEBHOOK_URL=""

# Discord Bot token and Public Key (same Application as OAuth).
# Bot → Reset Token / copy token. General Information → Public Key (64 hex chars).
# Invite the bot to the guild with Send Messages + Embed Links.
# Enable **Server Members Intent** under Bot settings so member sync works.
# Set Interactions Endpoint URL to <AUTH_URL>/api/discord/interactions
# (must be a public HTTPS URL — localhost will not work for Discord callbacks).
DISCORD_BOT_TOKEN=""
DISCORD_PUBLIC_KEY=""

# Comma separated Discord user IDs that are always guild managers (admins).
# Right-click your name in Discord with Developer Mode on to copy your ID.
# If this is empty, the first account that signs in becomes the admin.
ADMIN_DISCORD_IDS=""

# Comma separated Discord role IDs whose members become guild managers (admins).
ADMIN_DISCORD_ROLE_IDS="1522288621296685076"

# Never enable this on Netlify/production.
ALLOW_DEV_LOGIN="false"
